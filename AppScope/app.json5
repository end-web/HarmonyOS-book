{
  "app": {
    "bundleName": "com.huan.listenbook",
    "cloudFileSyncEnabled": true,
    "vendor": "ylwang",
    "versionCode": 1000042,
    "versionName": "0.1.42",
    "buildVersion": "1",
    "icon": "$media:app_icon",
    "alternateIcons": [
      { "name": "leather", "icon": "$media:app_icon_leather" },
      { "name": "enamel", "icon": "$media:app_icon_enamel" },
      { "name": "ink", "icon": "$media:app_icon_ink" },
      { "name": "clay", "icon": "$media:app_icon_clay" },
      { "name": "glass", "icon": "$media:app_icon_glass" },
      { "name": "origami", "icon": "$media:app_icon_origami" },
      { "name": "embroidery", "icon": "$media:app_icon_embroidery" },
      { "name": "retro", "icon": "$media:app_icon_retro" },
      { "name": "cartoon", "icon": "$media:app_icon_cartoon" },
      { "name": "cartooncat", "icon": "$media:app_icon_cartooncat" },
      { "name": "cartoondog", "icon": "$media:app_icon_cartoondog" }
    ],
    "label": "$string:app_name"
  }
}
