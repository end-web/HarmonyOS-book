const T2S_MAP: Map<string, string> = new Map();
for (let i = 0; i < T2S_ENTRIES.length; i++) {
  T2S_MAP.set(T2S_ENTRIES[i][0], T2S_ENTRIES[i][1]);
}

// 构建简体→繁体映射（取第一个匹配）
const S2T_MAP: Map<string, string> = new Map();
T2S_MAP.forEach((simplified: string, traditional: string) => {
  if (!S2T_MAP.has(simplified)) {
    S2T_MAP.set(simplified, traditional);
  }
});

/**
 * 繁体转简体
 */
export function t2s(text: string): string {
  if (!text) return '';
  let result = '';
  for (let i = 0; i < text.length; i++) {
    const ch = text[i];
    const mapped = T2S_MAP.get(ch);
    result += mapped !== undefined ? mapped : ch;
  }
  return result;
}

/**
 * 简体转繁体
 */
export function s2t(text: string): string {
  if (!text) return '';
  let result = '';
  for (let i = 0; i < text.length; i++) {
    const ch = text[i];
    const mapped = S2T_MAP.get(ch);
    result += mapped !== undefined ? mapped : ch;
  }
  return result;
}
